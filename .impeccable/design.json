  "narrative": {
    "northStar": "Achromatic ledger",
    "overview": "TaskFlow uses the Achromatic ledger world as a calm working surface. Ink establishes hierarchy; aligned metadata and flat grouped containers keep tasks readable. Top navigation supports personal work without account or collaboration ornament.\n\nLight and dark are equal saved preferences. Self-hosted Geist, native controls, stroke SVG icons and an accessible native dialog keep the interface direct. The focus-week strip represents real open-task deadlines.",
    "keyCharacteristics": [
      "Neutral chrome and inverse-ink primary actions.",
      "Compact type and regular tabular numerals.",
      "Flat containers, fine rules and semantic color.",
      "Visible focus and native status alternatives to dragging."
    ],
    "rules": [
      {
        "name": "The Deadline Signal Rule",
        "body": "Within task metadata, negative color identifies overdue dates; High priority remains ink with a flag and explicit label. Errors and destructive actions use the negative channel in their own contexts.",
        "section": "colors"
      },
      {
        "name": "The Single Family Rule",
        "body": "Use Geist for text and numbers, with tabular numerals inherited from the body; do not add decorative display or monospace roles.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use tonal fills and fine borders for ordinary hierarchy. Reserve the implemented shadow for transient toast feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain neutral High-priority text and a flag while overdue dates use the negative signal.",
      "Do bind new UI to light and dark CSS variables, including inverse primary text.",
      "Do preserve visible focus, descriptive labels and native status controls beside dragging.",
      "Do use the established type roles, flat surfaces and SVG stroke icons."
    ],
    "donts": [
      "Don't add saturated navigation, decorative gradients or colored metric tiles.",
      "Don't make color the only explanation of priority, overdue state or selection.",
      "Don't add animation or shadows to ordinary task containers."
    ]
  }
