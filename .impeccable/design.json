      "css": ".ds-panel{background:var(--surface);color:var(--ink);border:1px solid var(--border);border-radius:14px;padding:20px;max-width:290px;font:400 14px/1.5 var(--font)}.ds-panel h2{margin:0;font-size:15px;font-weight:600;line-height:1.4}.ds-panel p{color:var(--muted);margin:10px 0 0;font-size:13px}.ds-progress{height:5px;background:var(--raised);border-radius:6px;margin-top:18px;overflow:hidden}.ds-progress span{display:block;width:20%;height:100%;background:var(--ink);border-radius:6px}"
